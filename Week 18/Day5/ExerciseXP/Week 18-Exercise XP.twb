    <worksheet name='Exercise 6 - NA Sales Contribution'>
      <layout-options>
        <caption>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Exercise 6: North American Sales Contribution</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Research Question:</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'> What percentage of each game&apos;s global sales comes from North America?</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Calculation:</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'> SUM([NA Sales]) / SUM([Global Sales])</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Purpose:</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'> To determine how dependent the world&apos;s bestselling video games are on the North American market.</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Findings:</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'> Duck Hunt has the highest North American sales contribution among the 20 bestselling games, at 95.13%. Tetris follows at 73.02%, while Wii Sports generates 50.15% of its global sales in North America. Pokémon Red/Blue has a lower contribution of 35.93%, suggesting a more geographically diversified market.</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Conclusion:</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'> The results demonstrate that bestselling video games vary significantly in their dependence on North American sales.</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='vgsales' name='federated.03y5z5j0c9kysd16hhevv1wfhhlf' />
          </datasources>
          <datasource-dependencies datasource='federated.03y5z5j0c9kysd16hhevv1wfhhlf'>
            <column caption='NA Sales Contribution' datatype='real' default-format='p0.00%' name='[Calculation_0223201565929479]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([Global_Sales]) != 0 THEN&#13;&#10;    SUM([NA_Sales]) / SUM([Global_Sales])&#13;&#10;END' />
            </column>
            <column caption='Global Sales' datatype='real' name='[Global_Sales]' role='measure' type='quantitative' />
            <column caption='NA Sales' datatype='real' name='[NA_Sales]' role='measure' type='quantitative' />
            <column datatype='string' name='[Name]' role='dimension' type='nominal' />
            <column-instance column='[Name]' derivation='None' name='[none:Name:nk]' pivot='key' type='nominal' />
            <column-instance column='[Global_Sales]' derivation='Sum' name='[sum:Global_Sales:qk]' pivot='key' type='quantitative' />
            <column-instance column='[NA_Sales]' derivation='Sum' name='[sum:NA_Sales:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_0223201565929479]' derivation='User' name='[usr:Calculation_0223201565929479:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.03y5z5j0c9kysd16hhevv1wfhhlf].[none:Name:nk]'>
            <groupfilter count='20' end='top' function='end' units='records' user:ui-marker='end' user:ui-top-by-field='true'>
              <groupfilter direction='DESC' expression='SUM([Global_Sales])' function='order' user:ui-marker='order'>
                <groupfilter function='level-members' level='[none:Name:nk]' user:ui-manual-selection='true' user:ui-manual-selection-all-when-empty='true' user:ui-manual-selection-is-empty='true' user:ui-marker='enumerate' />
              </groupfilter>
            </groupfilter>
          </filter>
          <computed-sort column='[federated.03y5z5j0c9kysd16hhevv1wfhhlf].[none:Name:nk]' direction='DESC' using='[federated.03y5z5j0c9kysd16hhevv1wfhhlf].[sum:Global_Sales:qk]' />
          <slices>
            <column>[federated.03y5z5j0c9kysd16hhevv1wfhhlf].[none:Name:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style />
