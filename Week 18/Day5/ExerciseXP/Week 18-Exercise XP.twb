      <aliases enabled='yes' />
      <column caption='Profitability Index' datatype='real' name='[Calculation_0223201558634496]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Global_Sales] != 0 THEN&#13;&#10;    ([Global_Sales] - ([Global_Sales] * 0.30))&#13;&#10;    / [Global_Sales]&#13;&#10;END' />
      </column>
      <column caption='Sales Performance Index' datatype='integer' name='[Calculation_0223201560866817]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK(SUM([Global_Sales]), &apos;desc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='YoY Growth Rate' datatype='real' name='[Calculation_0223201562181636]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Global_Sales]) -&#13;&#10;LOOKUP(SUM([Global_Sales]), -1))&#13;&#10;/&#13;&#10;LOOKUP(SUM([Global_Sales]), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Genre Dominance Ratio' datatype='real' name='[Calculation_0223201563516934]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Global_Sales]) / TOTAL(SUM([Global_Sales]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='NA Sales Contribution' datatype='real' default-format='p0.00%' name='[Calculation_0223201565929479]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([Global_Sales]) != 0 THEN&#13;&#10;    SUM([NA_Sales]) / SUM([Global_Sales])&#13;&#10;END' />
      </column>
      <column caption='EU Sales (bin)' datatype='integer' name='[EU Sales (bin)]' role='dimension' type='ordinal'>
        <calculation class='bin' decimals='0' formula='[EU_Sales]' peg='0' size='5' />
      </column>
      <column caption='EU Sales' datatype='real' name='[EU_Sales]' role='measure' type='quantitative' />
      <column caption='Global Sales' datatype='real' name='[Global_Sales]' role='measure' type='quantitative' />
